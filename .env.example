# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill it in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Postgres. Neon, Supabase and Vercel Postgres all give you a URL like this.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Where the app is running. Used to build OAuth redirect URIs and share links.
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Google sign-in. Create an OAuth client at console.cloud.google.com:
#   APIs & Services -> Credentials -> Create credentials -> OAuth client ID
#   Application type: Web application
#   Authorised redirect URI: <APP_URL>/api/auth/callback
# Then publish the consent screen to Production, or only test accounts can
# sign in. Scopes needed: openid, email, profile (all non-sensitive, so no
# verification and no "unverified app" warning).
#
# Leave these blank during development: the app falls back to a local
# sign-in that needs no Google account. It refuses to run in production.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# The documentation inbox. One Gmail account serves every trip through
# plus-addressing: tour.repot+<inbox_token>@gmail.com
# GMAIL_APP_PASSWORD is the 16-character app password, not the account
# password. Requires 2-Step Verification on the account.
# Leave blank to disable email ingestion; everything else still works.
# ---------------------------------------------------------------------------
GMAIL_USER="tour.repot@gmail.com"
GMAIL_APP_PASSWORD=""
